package frc.robot.subsystems;

import edu.wpi.first.wpilibj.DigitalInput;
import edu.wpi.first.wpilibj2.command.SubsystemBase;
import com.ctre.phoenix6.hardware.TalonFX;

public class Drivetrain extends SubsystemBase {
  private TalonFX leftMotor = new TalonFX(0);
  private TalonFX rightMotor = new TalonFX(1);
  private DigitalInput sensor1 = new DigitalInput(0);
  private DigitalInput sensor2 = new DigitalInput(1);
  private int currentState = 1;

  /** Creates a new Drivetrain. */
  public Drivetrain() {}

  public void drive(double speed, double turn) {
    double leftSpeed = 0.2;
    double rightSpeed = 0.2;

    leftMotor.set(leftSpeed);
    rightMotor.set(-rightSpeed);
  }

  public void setMode(int mode) {
    currentState = mode;
  }

  @Override
  public void periodic() {
    // This method will be called once per scheduler run
    
  //Mode 1 (default): Drive until both are seen
  if (currentState == 1) {
    if ((sensor1.get() && !sensor2.get()) || (sensor2.get() && !sensor1.get())) {
      drive(0.2, 0.2);
    }

    else if (sensor1.get() && sensor2.get()) {
      drive(0, 0);
    } 
  }

  //Mode 2: Drive until none are seen
  else if (currentState == 2) {
    if (!sensor1.get() && !sensor2.get()) {
      drive(0.2, 0.2);
    }

    else {
      setMode(1);
    }
  }
